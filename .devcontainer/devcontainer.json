{
  "name": "cadence-course-platform",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "jq,sqlite3"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Keep Linux node_modules in a volume so it never mixes with the host's
  // macOS build of better-sqlite3 (a native module).
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "postCreateCommand": "sudo chown node node_modules && npm ci && npm run db:migrate && ([ -f data.db ] || npm run db:seed)",
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": { "label": "App (npm run dev)", "onAutoForward": "openBrowser" },
    "8787": { "label": "Request logger", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "node"
}
